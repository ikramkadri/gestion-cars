            <button className="bg-blue-600 text-white px-10 py-5 rounded-3xl font-black hover:bg-blue-700 transition-all active:scale-95 shadow-xl shadow-blue-600/40 text-xl">
              ابـحث
            </button>
          </div>

          {/* Slider Indicators */}
          <div className="flex justify-center gap-3 mt-12">
